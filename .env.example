# Copy to .env (gitignored) and fill in. Real environment variables override these.

# Show your open Azure DevOps pull requests in the side panel.
AZURE_DEVOPS_ORG=7imdevops
# Personal access token with Code: Read scope.
AZURE_DEVOPS_PAT=
# Only needed when using an az CLI token instead of a PAT, and the org is in another tenant.
# AZURE_DEVOPS_TENANT=

# Sprint board: your stories in this team's current iteration (dashboard).
AZURE_DEVOPS_PROJECT=SevenIM
AZURE_DEVOPS_TEAM=Squad 5 - Portfolio Reporting

# How often to re-fetch Azure DevOps, in seconds (30, 60, 120, 300 or 900). Also changeable from the dashboard.
# REFRESH_SECONDS=60
